# IMPORTANT: This is an example file
# DO NOT commit actual secrets to git!
# 
# To create secrets:
# kubectl create secret generic sieve-secrets \
#   --from-literal=telegram-bot-token=YOUR_TOKEN \
#   --from-literal=groq-api-key=YOUR_KEY \
#   --from-literal=google-api-key=YOUR_KEY \
#   --namespace=sieve

apiVersion: v1
kind: Secret
metadata:
  name: sieve-secrets
  namespace: sieve
type: Opaque
data:
  # Base64 encoded values
  # Use: echo -n "your-token" | base64
  telegram-bot-token: <BASE64_ENCODED_TOKEN>
  groq-api-key: <BASE64_ENCODED_KEY>
  google-api-key: <BASE64_ENCODED_KEY>
